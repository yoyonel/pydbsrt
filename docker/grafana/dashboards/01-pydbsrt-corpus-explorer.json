          "rawSql": "SELECT m.id, m.name as \"Media Release\", round(m.fps::numeric, 2) as \"FPS\", m.frame_count as \"Frames\", s.lang as \"Lang\", count(sf.id) as \"Anchors\", substring(m.media_hash, 1, 8) as \"Digest\" FROM medias m LEFT JOIN subtitles s ON s.media_id = m.id LEFT JOIN sub_frames sf ON sf.subtitles_id = s.id GROUP BY m.id, m.name, m.fps, m.frame_count, s.lang, m.media_hash ORDER BY m.id DESC LIMIT 100;",
