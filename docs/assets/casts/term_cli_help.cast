[0.52, "o", "\r\n"]
[0.62, "o", "High-performance video perceptual hash & subtitle retargeting\r\n"]
[0.635, "o", "\r\n"]
[0.65, "o", "Usage: dbsrt <COMMAND>\r\n"]
[0.665, "o", "\r\n"]
[0.68, "o", "Commands:\r\n"]
[0.695, "o", "  bench-phash         Benchmark pHash computation throughput\r\n"]
[0.71, "o", "  bench-video         Benchmark video decoding throughput across CPU, HWAccel, sparse and keyframe modes\r\n"]
[0.725, "o", "  recognize-media     Recognize media from database or local phash files by computing perceptual hash fingerprint\r\n"]
[0.74, "o", "  retarget-subtitles  Retarget and synchronize SRT subtitles from reference to target media\r\n"]
[0.755, "o", "  export-phash        Export binary .phash file for a media using fast SIMD extraction\r\n"]
[0.77, "o", "  scan-library        Zero-DB fast search across directory of .phash files via memory mapping\r\n"]
[0.785, "o", "  bench-cuts          Benchmark scene cuts detection throughput across .phash files\r\n"]
[0.8, "o", "  import-phash        Import .phash binary file(s) into PostgreSQL 17 BK-Tree\r\n"]
[0.815, "o", "  certify-coupling    Certify and import a ground-truth (media/phash <-> subtitle) coupling into couplings.json and/or PostgreSQL [alias: import-subtitles]\r\n"]
[0.83, "o", "  inspect-media       Inspect media container tracks and release metadata\r\n"]
[0.845, "o", "  pack                Pack a directory of .phash files into a unified high-density .dbphash index\r\n"]
[0.86, "o", "  fetch-subtitles     Fetch subtitles from remote providers (OpenSubtitles REST) with local cache fallback\r\n"]
[0.875, "o", "  migrate             Apply or check versioned SQL database migrations (refinery) on PostgreSQL\r\n"]
[0.89, "o", "  media:add           Unified media ingestion facade: extract pHash, certify coupling, and hot-ingest into server [alias: media-add]\r\n"]
[0.905, "o", "  coupling:relabel    Relabel a certified subtitle language attribution and confidence status in couplings.json [alias: coupling-relabel]\r\n"]
[0.92, "o", "  help                Print this message or the help of the given subcommand(s)\r\n"]
[0.935, "o", "\r\n"]
[0.95, "o", "Options:\r\n"]
[0.965, "o", "  -h, --help     Print help\r\n"]
[0.98, "o", "  -V, --version  Print version\r\n"]
