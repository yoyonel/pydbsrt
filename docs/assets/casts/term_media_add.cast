[1.17, "o", "\r\n"]
[1.27, "o", "Unified media ingestion facade: extract pHash, certify coupling, and hot-ingest into server\r\n"]
[1.285, "o", "\r\n"]
[1.3, "o", "Usage: dbsrt media:add [OPTIONS] [VIDEO_PATH] [SRT_PATH]\r\n"]
[1.315, "o", "\r\n"]
[1.33, "o", "Arguments:\r\n"]
[1.345, "o", "  [VIDEO_PATH]  Positional video path if not passed with --video\r\n"]
[1.36, "o", "  [SRT_PATH]    Positional subtitle path if not passed with --srt\r\n"]
[1.375, "o", "\r\n"]
[1.39, "o", "Options:\r\n"]
[1.405, "o", "  -v, --video <VIDEO>                  Reference media video file (.mkv, .mp4, .webm, etc.)\r\n"]
[1.42, "o", "  -s, --srt <SRT>                      Reference subtitle file (.srt)\r\n"]
[1.435, "o", "  -l, --lang <LANG>                    Subtitle ISO language code (e.g. \"fr\", \"en\")\r\n"]
[1.45, "o", "      --fps <FPS>                      Explicit framerate override (e.g. 23.976, 24.0, 25.0)\r\n"]
[1.465, "o", "      --phash-dir <PHASH_DIR>          Output directory storing .phash binary fingerprints [default: /tmp]\r\n"]
[1.48, "o", "      --subtitles-dir <SUBTITLES_DIR>  Directory storing certified .srt files and couplings.json [default: data/SRT]\r\n"]
[1.495, "o", "      --all-embedded                   Extract all embedded subtitle tracks from container even if sidecar subtitles exist\r\n"]
[1.51, "o", "      --skip-certify                   Dry-run mode: extract pHash fingerprint but skip coupling certification and ingest\r\n"]
[1.525, "o", "      --json                           Output execution summary in JSON format\r\n"]
[1.54, "o", "      --hwaccel <HWACCEL>              Hardware acceleration backend (auto, vaapi, cuda, qsv, disabled) [default: auto]\r\n"]
[1.555, "o", "      --server-url <SERVER_URL>        HTTP URL of dbsrt-server for live catalog ingestion [default: http://127.0.0.1:8765]\r\n"]
[1.57, "o", "      --db-host <HOST>                 PostgreSQL host (defaults to PSQL_IP env or 127.0.0.1). Note: explicitly passing --db-host also enables DB sync for certify-coupling\r\n"]
[1.585, "o", "      --db-port <PORT>                 PostgreSQL port [env: PSQL_PORT=] [default: 5433]\r\n"]
[1.6, "o", "      --db-user <USER>                 PostgreSQL user [default: docker]\r\n"]
[1.615, "o", "      --db-pass <PASS>                 PostgreSQL password [default: docker]\r\n"]
[1.63, "o", "      --db-name <NAME>                 PostgreSQL database name [default: bktreedb]\r\n"]
[1.645, "o", "  -h, --help                           Print help\r\n"]
[1.76, "o", "\u001b[1;34mpydbsrt\u001b[0m [\u001b[32mdevelop\u001b[0m] \u001b[1;36m\u276f\u001b[0m "]
