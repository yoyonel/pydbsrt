[1.11, "o", "⚡ REST API ROUTES (dbsrt-server :8765):\r\n"]
[1.125, "o", "  GET  /v1/status                           Santé du démon, uptime, compteurs pHash et statut PG\r\n"]
[1.14, "o", "  GET  /v1/couplings?summary=true           Liste synthétique des couplages certifiés\r\n"]
[1.155, "o", "  GET  /v1/couplings/sub_frames             Pagination des ancres SRT (?media_stem=...&offset=0&limit=50)\r\n"]
[1.17, "o", "  GET  /v1/media/stream?path=<path>         Streaming vidéo partiel HTML5 (Range bytes)\r\n"]
[1.185, "o", "  POST /v1/search                           Recherche sous-titres (pHash consensus + local + OpenSubtitles)\r\n"]
[1.2, "o", "  POST /v1/certify                          Certification et insertion à chaud de couplage ground-truth\r\n"]
[1.215, "o", "  POST /v1/sync                             Recalage temporel direct et génération de .dbsrt.srt\r\n"]
