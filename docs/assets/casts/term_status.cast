[0.785, "o", "\r\n"]
[0.885, "o", "================================================================================\r\n"]
[0.9, "o", "                    pydbsrt \u2014 Unified Stack Status & Guide                      \r\n"]
[0.915, "o", "================================================================================\r\n"]
[0.93, "o", "\r\n"]
[0.945, "o", "\ud83d\udce1 SERVICES & HEALTH CHECK:\r\n"]
[0.96, "o", "  dbsrt Studio & REST API          : [ UP ] HTTP 200 (http://127.0.0.1:8765/v1/status)\r\n"]
[0.975, "o", "  MkDocs Portal & Dashboards       : [ UP ] HTTP 302 (http://127.0.0.1:8000/)\r\n"]
[0.99, "o", "  Grafana Dashboard (Docker)       : [ UP ] HTTP 200 (http://127.0.0.1:3000/)\r\n"]
[1.005, "o", "  PgWeb SQL Explorer (Docker)      : [ UP ] HTTP 200 (http://127.0.0.1:8086/)\r\n"]
[1.02, "o", "  Prometheus TSDB (Docker)         : [ UP ] HTTP 200 (http://127.0.0.1:9090/)\r\n"]
[1.035, "o", "  Prometheus Exporter (Docker)     : [ UP ] HTTP 200 (http://127.0.0.1:9187/metrics)\r\n"]
[1.05, "o", "  PostgreSQL 17 SP-GiST            : [ UP ] (127.0.0.1:5433 - bktreedb)\r\n"]
[1.065, "o", "  VLC Lua Plugins                  : [INSTALLED] (~/.local/share/vlc/lua/...)\r\n"]
[1.08, "o", "\r\n"]
[1.095, "o", "\ud83d\uddc4\ufe0f  DATABASE & FINGERPRINT TELEMETRY:\r\n"]
[1.11, "o", "  \u2022 PostgreSQL 17 status : Connected\r\n"]
[1.125, "o", "  \u2022 Medias indexed in DB : 1\r\n"]
[1.14, "o", "  \u2022 Video Frames (pHash) : 812\r\n"]
[1.155, "o", "  \u2022 Subtitles registered : 1\r\n"]
[1.17, "o", "  \u2022 Cue-Frame Anchors    : 8\r\n"]
[1.185, "o", "  \u2022 Local pHash Files    : 1675\r\n"]
[1.2, "o", "  \u2022 Certified Couplings  : 70\r\n"]
[1.215, "o", "\r\n"]
[1.23, "o", "\ud83c\udf10 USER INTERFACES & DASHBOARDS (Where to go):\r\n"]
[1.245, "o", "  \ud83c\udf9b\ufe0f  dbsrt Studio UI    -> http://127.0.0.1:8765/studio\r\n"]
[1.26, "o", "      Application web : Timeline bi-piste, loupe 8x8 pHash, vid\u00e9o HTML5, recalage 1-clic.\r\n"]
[1.275, "o", "  \ud83d\udcca  Grafana Dashboard  -> http://127.0.0.1:3000/\r\n"]
[1.29, "o", "      Monitoring visuel PostgreSQL 17 (QPS, connexions, cache hit ratio, deadlocks - zero login).\r\n"]
[1.305, "o", "  \ud83d\udcda  Portail Doc & E2E  -> http://127.0.0.1:8000/\r\n"]
[1.32, "o", "      Documentation, architecture Di\u00e1taxis, et Dashboard interactif E2E VLC NAS.\r\n"]
[1.335, "o", "  \ud83d\udc18  PgWeb Explorer    -> http://127.0.0.1:8086/\r\n"]
[1.35, "o", "      Explorateur SQL zero-conf pour requ\u00eater medias, frames, subtitles et sub_frames.\r\n"]
[1.365, "o", "  \ud83d\udd25  Prometheus Console -> http://127.0.0.1:9090/\r\n"]
[1.38, "o", "      Moteur TSDB, exploration PromQL et cibles de scraping (/targets).\r\n"]
[1.395, "o", "\r\n"]
[1.41, "o", "\u26a1 REST API ROUTES (dbsrt-server :8765):\r\n"]
[1.425, "o", "  GET  /v1/status                           Sant\u00e9 du d\u00e9mon, uptime, compteurs pHash et statut PG\r\n"]
[1.44, "o", "  GET  /v1/couplings?summary=true           Liste synth\u00e9tique des couplages certifi\u00e9s\r\n"]
[1.455, "o", "  GET  /v1/couplings/sub_frames             Pagination des ancres SRT (?media_stem=...&offset=0&limit=50)\r\n"]
[1.47, "o", "  GET  /v1/media/stream?path=<path>         Streaming vid\u00e9o partiel HTML5 (Range bytes)\r\n"]
[1.485, "o", "  POST /v1/search                           Recherche sous-titres (pHash consensus + local + OpenSubtitles)\r\n"]
[1.5, "o", "  POST /v1/certify                          Certification et insertion \u00e0 chaud de couplage ground-truth\r\n"]
[1.515, "o", "  POST /v1/sync                             Recalage temporel direct et g\u00e9n\u00e9ration de .dbsrt.srt\r\n"]
[1.53, "o", "\r\n"]
[1.545, "o", "\ud83d\udccb LOGS & DIAGNOSTICS:\r\n"]
[1.56, "o", "  \u2022 dbsrt-server logs  : task server:logs  (tail -f /tmp/dbsrt-server.log)\r\n"]
[1.575, "o", "  \u2022 MkDocs server logs : task doc:logs     (tail -f /tmp/dbsrt-docs.log)\r\n"]
[1.59, "o", "  \u2022 Docker stack logs  : task db:logs      (docker compose -f docker/docker-compose.yml logs -f)\r\n"]
[1.605, "o", "\r\n"]
[1.62, "o", "\ud83c\udfac VLC MEDIA PLAYER:\r\n"]
[1.635, "o", "  \u2022 task vlc:run       : Lance VLC avec l'extension VLSub dbsrt charg\u00e9e\r\n"]
[1.65, "o", "  \u2022 task vlc:demo      : D\u00e9monstration live interactive avec sous-titre recal\u00e9 et OSD\r\n"]
[1.665, "o", "================================================================================\r\n"]
